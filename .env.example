# ComfyUI API Gateway Environment Configuration

# Gateway Authentication Keys
ADMIN_API_KEY="sk_admin_hardonianaicomfyui_secret"
WORKER_API_KEY="sk_worker_gpu_node_secret"
CLIENT_API_KEY="sk_client_app_secret"

# Cloudflare Worker Environment Variables
ENVIRONMENT="production"
APP_NAME="comfyui-api"
LOG_LEVEL="INFO"
LEASE_TIMEOUT_SECONDS=180
MAX_CONCURRENT_JOBS=10

# GPU Worker Daemon Configuration
COMFYUI_API_URL="http://127.0.0.1:8787"
COMFY_URL="http://127.0.0.1:8188"
NODE_ID="node-epyc-gpu-01"
OUTPUT_DIR="./outputs"
POLL_INTERVAL=3.0
HEARTBEAT_INTERVAL=30.0

# Cloudflare Credentials (for CI/CD deployments)
CLOUDFLARE_API_TOKEN="your-cf-api-token"
CLOUDFLARE_ACCOUNT_ID="your-cf-account-id"
DOMAIN="api.comfyui.hardonian.com"
