# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development

# ── Required ─────────────────────────────────────
# JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-string

# HMAC key for outbound webhook signatures
WEBHOOK_SIGNING_KEY=change-me-to-a-random-string

# Cloudflare credentials (for CLI deployment)
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ── Optional ─────────────────────────────────────
# Email delivery (Resend API)
EMAIL_API_KEY=
EMAIL_FROM=alerts@api-changelog-radar.com

# CORS override (comma-separated origins)
CORS_ORIGINS=http://localhost:8788,http://localhost:3000
